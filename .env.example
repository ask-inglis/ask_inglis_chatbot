# AskInglis backend settings. Copy this file to .env and fill in real values.
# Never commit .env. Never paste real keys into chat, Trello or the frontend.

# Which model answers questions: "gemini" (public site) or "bullsai" (UB network only)
LLM_PROVIDER=gemini
# If a non-Gemini provider fails, fall back to Gemini
LLM_FALLBACK=true

# BullsAI (UB gateway; UB network or VPN only, not reachable from Render)
# gpt-oss models spend tokens thinking, so keep max tokens high or quizzes come back empty.
BULLSAI_API_KEY=
BULLSAI_BASE_URL=https://gateway.bullsai.buffalo.edu/v1
BULLSAI_MODEL_NAME=openai/gpt-oss-120b
BULLSAI_TIMEOUT=300
BULLSAI_MAX_TOKENS=10000

# Gemini (main model for the public site)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
# Tried in order if the main model is busy or retired (comma separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=300

# Search: keep a note chunk only if it is within this multiple of the best match
RETRIEVAL_DISTANCE_RATIO=1.3

# Custom provider (any OpenAI-compatible service). Not used now; leave commented out.
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_MODEL_NAME=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_TIMEOUT=60
# CUSTOM_LLM_MAX_TOKENS=8000

# Private notes repo. The GitHub App (ask-inglis-bot) is the normal way in.
GITHUB_NOTES_REPO=ask-inglis/ask_inglis_notes
GITHUB_APP_ID=
# The private key on one line, with \n in place of line breaks, inside quotes
GITHUB_APP_PRIVATE_KEY=
# Names the GitHub App bot on feedback resolution commits
GITHUB_BOT_NAME=
GITHUB_BOT_EMAIL=

# Protects the /admin routes. Long random string; share only in private messages.
ADMIN_API_KEY=

# Images beside answers
IMAGES_IN_REPLY=true
# Smaller = stricter picture matching
MAX_IMAGE_DISTANCE=1.0

# Answer checking
EXTERNAL_SOURCES=wikipedia
# Wikipedia asks bots to identify themselves. Keep the quotes; a # would cut it off.
WIKI_USER_AGENT="AskInglisBot/1.0 (UB CDA 650 student project; contact: your-email@buffalo.edu)"
DISPUTE_IN_CHAT=true

# Websites allowed to call the API (scheme and host only, no path, comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://ask-inglis.github.io
# Number of proxies in front of the server (Render uses 1)
TRUSTED_PROXY_HOPS=1

# Limits per address per minute. Generous on purpose, since a lab of students can share one address.
CHAT_PER_MIN=40
DISPUTE_PER_MIN=15
FEEDBACK_PER_MIN=40
IMAGES_PER_MIN=80
TITLE_PER_MIN=30

# Questions per day across everyone. Leave at 0 on the free tier, since Gemini enforces its own limit.
DAILY_CHAT_LIMIT=0

# Answer cache: 21600 seconds is 6 hours. 0 turns it off.
CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=500

# Public address of this backend (used to build image links). On Render, use the live address.
PUBLIC_BASE_URL=http://localhost:8000

# Phase 2 practice questions. Keep false on the public site until Phase 2 is approved.
QUIZ_IN_CHAT=false
QUESTION_OPTIONS=5