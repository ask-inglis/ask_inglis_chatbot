# AskInglis backend settings. Copy this file to backend/.env and fill in real values.
# Never commit .env. Never paste real keys into chat, Trello or the frontend.
# The backend reads this file only when it starts. Restart it after changing a value.

# Which model answers questions: "gemini" (public site) or "bullsai" (UB network only)
LLM_PROVIDER=gemini
# If a non-Gemini provider fails, fall back to Gemini
LLM_FALLBACK=true

# BullsAI (UB gateway; UB network or VPN only, not reachable from the droplet)
# gpt-oss models spend tokens thinking, so keep max tokens high or quizzes come back empty.
BULLSAI_API_KEY=
BULLSAI_BASE_URL=https://gateway.bullsai.buffalo.edu/v1
BULLSAI_MODEL_NAME=openai/gpt-oss-120b
BULLSAI_TIMEOUT=300
BULLSAI_MAX_TOKENS=10000

# Gemini (main model for the public site)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# Tried in order if the main model is busy or retired (comma separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=300

# Search: keep a note chunk only if it is within this multiple of the best match
RETRIEVAL_DISTANCE_RATIO=1.3

# Model calls per minute and per day shared by everyone. Keep them under Gemini's own limits.
LLM_RPM_LIMIT=9
LLM_RPD_LIMIT=450
# Model calls one practice quiz needs
LLM_QUIZ_CALLS_NEEDED=6

# Private notes repo. The GitHub App (ask-inglis-bot) is the normal way in.
GITHUB_BOT_NAME=
GITHUB_BOT_EMAIL=
GITHUB_NOTES_REPO=ask-inglis/ask_inglis_notes
GITHUB_APP_ID=
# The private key on one line, with \n in place of line breaks, inside quotes
GITHUB_APP_PRIVATE_KEY=
# Protects the /admin routes. Long random string; share only in private messages.
# The professor portal's STUDENT_CHATBOT_ADMIN_KEY must have the same value.
ADMIN_API_KEY=

# Images beside answers
IMAGES_IN_REPLY=true
# Smaller = stricter picture matching
MAX_IMAGE_DISTANCE=1.0

# Answer checking
EXTERNAL_SOURCES=wikipedia
# Wikipedia asks bots to identify themselves. Keep the quotes; a # would cut it off.
WIKI_USER_AGENT="AskInglisBot/1.0 (UB CDA 650 student project; contact: your-email@buffalo.edu)"
DISPUTE_IN_CHAT=true

# Websites allowed to call the API (scheme and host only, no path, comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,https://inglis.gansonstreet.com,https://app.159-203-143-149.sslip.io,https://ask-inglis.github.io
# Number of proxies in front of the server. On the droplet it is 1 (the droplet's nginx).
TRUSTED_PROXY_HOPS=1

# Limits per address per minute. Generous on purpose, since a lab of students can share one address.
CHAT_PER_MIN=40
DISPUTE_PER_MIN=15
FEEDBACK_PER_MIN=40
IMAGES_PER_MIN=80
TITLE_PER_MIN=30

# Questions per day across everyone. Leave at 0 on the free tier, since Gemini enforces its own limit.
DAILY_CHAT_LIMIT=0

# Answer cache: 21600 seconds is 6 hours. 0 turns it off.
CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=500

# Public address of this backend (used to build image links). Live: https://api.159-203-143-149.sslip.io
PUBLIC_BASE_URL=http://localhost:8000

# Phase 2 practice questions
QUIZ_IN_CHAT=true
QUESTION_OPTIONS=5
QUIZ_SPARES=6
QUIZ_SHORT_OK=1
QUIZ_PARALLEL_CALLS=4

# Optional: path of the question-style note inside the notes repo (for example style/question_style.md)
QUIZ_STYLE_REPO_PATH=
# Key for the professor portal's connection to this backend. Keep it secret.
PROFESSOR_INTEGRATION_KEY=

# For load tests only: keep test traffic out of the real log
# CHATLOG_DIR=loadtest_log
# CHATLOG_REPO_FOLDER=chatlog-loadtest